[alias]
  a = add
  c = commit --verbose
  d = diff
  l = log
  p = push origin HEAD
  pf = push --force origin HEAD
  recent = branch \
    --sort=-committerdate \
    --format='%(committerdate:short) %(refname:short)'
  s = status
[core]
  excludesfile = ~/.gitignore
[merge]
  ff = only
[pull]
  ff = only
